@model List<HotelProgramma.Models.Room>

<h1>Rooms</h1>

<table>
	<thead>
		<tr>
			<t	<th>Price</th>
			<th>Available</th>
		</tr>
	</thead>
	<tbody>
	@foreach (var room in Model)
	{
		<tr>
			<td>@room.RoomNumber</td>
			<td>@room.HotelRoomPrice</td>
			<td>@room.IsAvailable</td>
		</tr>
	}
	</tbody>
</table>